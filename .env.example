# Naming template for FUTURE live integration fixtures. No .env auto-loading.
# Current unit tests require none of these settings and make no provider calls.
# See docs/testing.md. Use dedicated test credentials; never commit real values.
ASGARD_LOKI_TEST_LIVE=false
ASGARD_LOKI_TEST_MAX_REQUESTS=5
ASGARD_LOKI_TEST_TIMEOUT_SECONDS=90

# Volcengine LLM: required fields depend on the explicitly selected protocol.
ASGARD_LOKI_TEST_VOLCENGINE_LLM_API_KEY=
ASGARD_LOKI_TEST_VOLCENGINE_LLM_BASE_URL=
ASGARD_LOKI_TEST_VOLCENGINE_LLM_CHAT_MODEL=
ASGARD_LOKI_TEST_VOLCENGINE_LLM_RESPONSES_MODEL=

# OpenAI LLM: independent configuration; no fallback to OPENAI_API_KEY.
ASGARD_LOKI_TEST_OPENAI_LLM_API_KEY=
ASGARD_LOKI_TEST_OPENAI_LLM_BASE_URL=
ASGARD_LOKI_TEST_OPENAI_LLM_CHAT_MODEL=
ASGARD_LOKI_TEST_OPENAI_LLM_RESPONSES_MODEL=

# Volcengine speech: API_KEY OR APP_ID + ACCESS_KEY, never both.
ASGARD_LOKI_TEST_VOLCENGINE_AUDIO_API_KEY=
ASGARD_LOKI_TEST_VOLCENGINE_AUDIO_APP_ID=
ASGARD_LOKI_TEST_VOLCENGINE_AUDIO_ACCESS_KEY=
ASGARD_LOKI_TEST_VOLCENGINE_AUDIO_RESOURCE_ID=
ASGARD_LOKI_TEST_VOLCENGINE_AUDIO_VOICE=
ASGARD_LOKI_TEST_VOLCENGINE_AUDIO_ENDPOINT=

# OpenAI images: API_KEY + MODEL required; remaining fields optional.
ASGARD_LOKI_TEST_OPENAI_IMAGE_API_KEY=
ASGARD_LOKI_TEST_OPENAI_IMAGE_MODEL=
ASGARD_LOKI_TEST_OPENAI_IMAGE_BASE_URL=
ASGARD_LOKI_TEST_OPENAI_IMAGE_ORGANIZATION=
ASGARD_LOKI_TEST_OPENAI_IMAGE_PROJECT=

# Only for explicitly selected Redis integration, not provider-only scenarios.
ASGARD_LOKI_TEST_REDIS_CONNECTION_STRING=

# Optional additional LLM target; only used by scenarios selecting SECONDARY.
# ASGARD_LOKI_TEST_VOLCENGINE_LLM_SECONDARY_API_KEY=
# ASGARD_LOKI_TEST_VOLCENGINE_LLM_SECONDARY_BASE_URL=
# ASGARD_LOKI_TEST_VOLCENGINE_LLM_SECONDARY_CHAT_MODEL=
# ASGARD_LOKI_TEST_VOLCENGINE_LLM_SECONDARY_RESPONSES_MODEL=
