# Only four variables for the explicit Volcengine LLM integration suite.
# See docs/testing.md. No .env auto-loading; never commit a real key.
ASGARD_LOKI_TEST_LIVE=false
ASGARD_LOKI_TEST_VOLCENGINE_LLM_API_KEY=
ASGARD_LOKI_TEST_VOLCENGINE_LLM_CHAT_MODEL=doubao-seed-evolving
ASGARD_LOKI_TEST_VOLCENGINE_LLM_RESPONSES_MODEL=doubao-seed-evolving
